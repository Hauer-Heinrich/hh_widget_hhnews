{
    "type": "typo3-cms-extension",
    "name": "hauerheinrich/hh-widget-hhnews",
    "description": "Hauer-Heinrich - Widget news for the dashboard.",
    "keywords": ["TYPO3 CMS", "extension", "widget"],
    "homepage": "https://www.hauer-heinrich.de",
    "license": ["GPL-2.0-or-later"],
    "authors": [
        {
            "name": "Christian Hackl",
            "homepage": "http://www.hauer-heinrich.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Hauer-Heinrich/hh_widget_hhnews/issues",
        "source": "https://github.com/Hauer-Heinrich/hh_widget_hhnews",
        "docs": "https://github.com/Hauer-Heinrich/hh_widget_hhnews/blob/master/README.md"
    },
    "funding": [
        {
            "type": "paypal",
            "url": "https://www.paypal.com/paypalme/hauerheinrich"
        }
    ],
    "require": {
        "typo3/cms-core": "^12.4.0 || ^13.4.0",
        "typo3/cms-dashboard": "^12.4.0 || ^13.4.0"
    },
    "autoload": {
        "psr-4": {
            "HauerHeinrich\\HhWidgetHhnews\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/Web",
            "extension-key": "hh_widget_hhnews",
            "version": "1.3.0",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "archive": {
        "exclude": [
            "/.git/",
            "/.github/",
            "/.idea/",
            "/.editorconfig",
            "/.gitattributes",
            "/.gitignore",
            "/.bundle.config.json",
            "/.bundle.config.json.example",
            "/.bundle.mjs",
            "/package.json",
            "/package-lock.json",
            "/*.code-workspace",
            "**/node_modules/",
            "**/*.zip"
        ]
    }
}
